{
  "manifest_version": 3,
  "name": "Parts & Customer Lookup",
  "version": "1.0.0",
  "description": "Read-only lookup for spare parts (stock, cost, sales history) and customers, active only while logged into Odoo.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://digandlift.odoo.com/*"],
      "js": ["content-scripts/odoo-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://digandlift.odoo.com/*"]
}
